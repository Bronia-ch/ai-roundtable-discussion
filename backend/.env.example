# 后端环境变量示例（复制为 backend/.env 后按需修改；不要提交真实 .env）
# 前缀 LLM_ 由 app/config.py 的 Settings 读取（pydantic-settings，env_prefix="LLM_"）

# DeepSeek/OpenAI 兼容 API 基址（默认 https://api.deepseek.com/v1）
LLM_BASE_URL=https://api.deepseek.com/v1

# API Key（留空则真实调用必然失败——测试全程使用 FakeLLM，不发起网络请求）
LLM_API_KEY=

# 模型名占位符：请按您账户实际可用的 DeepSeek V4 Pro 模型 ID 填写
# （本仓库从未验证过具体模型标识，不得凭默认值推断）
LLM_MODEL=your-deepseek-v4-pro-model-id

# SQLite 数据库路径（默认 ./data/app.db；E2E 使用 :memory:）
LLM_SQLITE_PATH=./data/app.db
